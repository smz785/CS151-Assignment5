<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" xmlns:fx="http://javafx.com/fxml"
    fx:controller="org.example.cs153assignment5.AboutController">

    <VBox spacing="12" alignment="TOP_LEFT">
        <padding>
            <Insets top="32" right="24" bottom="24" left="24"/>
        </padding>

        <Label text="About This Game"
            style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #36522a"/>

        <Label text="Our version of Rock, Paper, Scissors is a classic game against a machine learning opponent."
            wrapText="true"/>

        <Label text="The computer uses a learning algorithm that adapts to your playing patterns."
            wrapText="true"/>

        <Label text="Developers: Asmita Dulla, Gianna Nicomedes, Mahika Kachhwaha, Zain Mohammed"
            style="-fx-font-size: 14px; -fx-text-fill: #a8b79f;"/>

        <Button text="← Back" onAction="#onBackClick"/>
    </VBox>
</VBox>