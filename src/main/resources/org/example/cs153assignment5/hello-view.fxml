<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
    fx:controller="org.example.cs153assignment5.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="✊✋✌"
            style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #36522a"/>

    <Label text="Rock Paper Scissors!"
            style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #36522a"/>

    <Button text="Start" onAction="#onNewGameClick"/>
    <Button text="About" onAction="#onAboutClick"/>
    <Button text="Exit" onAction="#onExitClick"/>
</VBox>