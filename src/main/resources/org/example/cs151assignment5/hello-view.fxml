<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
    fx:controller="org.example.cs151assignment5.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="✊✋✌" styleClass="label-title"/>

    <Label text="Rock Paper Scissors!" styleClass="label-title"/>

    <Button text="Start" onAction="#onNewGameClick"/>
    <Button text="About" onAction="#onAboutClick"/>
    <Button text="Exit" onAction="#onExitClick"/>
</VBox>